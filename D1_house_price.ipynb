   "source": [
    "# handling outliers\n",
    "data1 = data.select_dtypes(exclude='object')\n",
    "\n",
    "for column in data1:\n",
    "  Q1 = data.loc[:,column].quantile(0.25)\n",
    "  Q3 = data.loc[:,column].quantile(0.75)\n",
    "  IQR = Q3-Q1\n",
    "  lower_limit = Q1 - 1.5*IQR\n",
    "  upper_limit = Q3 + 1.5* IQR\n",
    "\n",
    "  data[data.loc[:,column]<lower_limit]\n",
    "\n",
    "  data[data.loc[:,column]>upper_limit]\n",
    "\n",
    "  data[(data.loc[:,column]<lower_limit)|(data.loc[:,column]>upper_limit)]\n",
    "\n",
    "  len(data[(data.loc[:,column]<lower_limit)|(data.loc[:,column]>upper_limit)])/len(data)*100\n",
    "\n",
    "  data.loc[(data.loc[:,column]<lower_limit) | (data.loc[:,column]>upper_limit),column]=data.loc[:,column].mean()\n",
    "\n",
    "  len(data[(data.loc[:,column]<lower_limit)|(data.loc[:,column]>upper_limit)])/len(data)*100\n",
    "\n",
    "\n",
    "  plt.figure(figsize=(6,4))\n",
    "  sns.boxplot(data,x=column)\n",
    "  plt.show()\n",
    "\n"
   ]
  },
