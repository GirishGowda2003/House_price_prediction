   "metadata": {
    "id": "VN62JZ38ey6S"
   },
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "le = LabelEncoder()\n",
    "\n",
    "for column in data2.select_dtypes(include='object').columns:\n",
    "  # Fill NaN values with the mode before encoding\n",
    "  data2[column] = data2[column].fillna(data2[column].mode()[0])\n",
    "  if data2[column].nunique() > 10:\n",
    "    data2.loc[:, column] = le.fit_transform(data2.loc[:, column])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "7e8ff0e2"
   },
   "source": [
    "### One-Hot Encoding for Categorical Features\n",
    "\n",
    "I'll now apply one-hot encoding to convert the nominal categorical features into a numerical format, which is suitable for machine learning models. I'll drop the first category to avoid multicollinearity. The numerical features from `data1` will then be combined with these new one-hot encoded features."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "9fe174c4"
   },
   "outputs": [],
   "source": [
    "cat_cols = []\n",
    "\n",
    "for column in data2.select_dtypes(include='object').columns:\n",
    "    data2[column] = data2[column].fillna(data2[column].mode()[0])\n",
    "\n",
    "    if data2[column].nunique() > 10:\n",
    "        cat_cols.append(column)\n",
    "\n",
    "data2 = pd.get_dummies(\n",
    "    data2,\n",
    "    columns=cat_cols,\n",
    "    drop_first=True,\n",
    "    dtype=int\n",
    ")"
   ]
  },
